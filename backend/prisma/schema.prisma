generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ────────────────────────────────────────────
enum Role {
  USER
  ADMIN
  PARTNER
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  name          String?
  role          Role     @default(USER)
  kycStatus     KycStatus @default(PENDING)
  solanaAddress  String?
  solanaPrivKey  String?  // encrypted, devnet only
  lxTokenAccount String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subscriptions   UserSubscription[]
  signalPasses    UserSignalPass[]
  trades          Trade[]
  affiliateCode   AffiliateCode?
  referredBy      AffiliateReferral? @relation("ReferredUser")
  referrals       AffiliateReferral[] @relation("Referrer")
  watchlistItems  WatchlistItem[]
  brokerConnections BrokerConnection[]
  instrumentsSubs   UserInstrumentsSub[]
  competitionEntries CompetitionEntry[]
  partnerships      Partnership[]
  affiliateSettlements AffiliateSettlement[]
}

// ─── Subscriptions ───────────────────────────────────────────
enum SubscriptionTierName {
  LIGHT
  VISION
  AI_TRADER
  ELITE
  HEDGE_FUND
  ULTRA
  INSTITUTIONAL
}

model SubscriptionTier {
  id          String   @id @default(uuid())
  name        SubscriptionTierName @unique
  price       Float
  signalsPerDay Int
  indicators  Int
  autoExecution Boolean @default(false)
  description String?
  features    String[] // list of feature keys
  createdAt   DateTime @default(now())

  userSubscriptions UserSubscription[]
}

model UserSubscription {
  id        String   @id @default(uuid())
  userId    String
  tierId    String
  active    Boolean  @default(true)
  startDate DateTime @default(now())
  endDate   DateTime?
  paymentId String?
  createdAt DateTime @default(now())

  user User             @relation(fields: [userId], references: [id])
  tier SubscriptionTier @relation(fields: [tierId], references: [id])
}

// ─── Signal Passes ───────────────────────────────────────────
enum SignalType {
  BINARY
  SCALPING
  SWING
}

enum PassDuration {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

model SignalPass {
  id       String       @id @default(uuid())
  type     SignalType
  duration PassDuration
  price    Float
  active   Boolean      @default(true)

  userPasses UserSignalPass[]
}

model UserSignalPass {
  id        String   @id @default(uuid())
  userId    String
  passId    String
  active    Boolean  @default(true)
  startDate DateTime @default(now())
  endDate   DateTime
  paymentId String?

  user User       @relation(fields: [userId], references: [id])
  pass SignalPass  @relation(fields: [passId], references: [id])
}

// ─── Asset Classes & Instruments ─────────────────────────────
model AssetClass {
  id   String @id @default(uuid())
  name String @unique // Forex, Crypto, Stocks, Commodities, Indices
  instruments Instrument[]
}

model Instrument {
  id           String @id @default(uuid())
  symbol       String @unique
  name         String
  assetClassId String

  assetClass AssetClass @relation(fields: [assetClassId], references: [id])
  signals    Signal[]
  watchlistItems WatchlistItem[]
}

// ─── Signals ─────────────────────────────────────────────────
enum SignalDirection {
  BUY
  SELL
}

model Signal {
  id           String          @id @default(uuid())
  instrumentId String
  type         SignalType
  direction    SignalDirection
  entryPrice   Float
  stopLoss     Float
  takeProfit   Float
  confidence   Float           // 0-100
  timeframe    String          // e.g. "5m", "1h", "4h"
  status       String          @default("ACTIVE") // ACTIVE, HIT_TP, HIT_SL, EXPIRED
  createdAt    DateTime        @default(now())
  expiresAt    DateTime?

  instrument Instrument @relation(fields: [instrumentId], references: [id])
  trades     Trade[]
}

// ─── Trades (Paper Trading) ──────────────────────────────────
enum TradeStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Trade {
  id          String      @id @default(uuid())
  userId      String
  signalId    String?
  instrument  String
  direction   SignalDirection
  entryPrice  Float
  exitPrice   Float?
  quantity    Float
  stopLoss    Float?
  takeProfit  Float?
  pnl         Float?
  status      TradeStatus @default(OPEN)
  openedAt    DateTime    @default(now())
  closedAt    DateTime?

  user   User    @relation(fields: [userId], references: [id])
  signal Signal? @relation(fields: [signalId], references: [id])
}

// ─── Watchlist ───────────────────────────────────────────────
model WatchlistItem {
  id           String @id @default(uuid())
  userId       String
  instrumentId String
  addedAt      DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  instrument Instrument @relation(fields: [instrumentId], references: [id])

  @@unique([userId, instrumentId])
}

// ─── Affiliate System ────────────────────────────────────────
model AffiliateCode {
  id     String @id @default(uuid())
  userId String @unique
  code   String @unique

  user        User              @relation(fields: [userId], references: [id])
  referrals   AffiliateReferral[]
  settlements AffiliateSettlement[]
}

model AffiliateReferral {
  id             String   @id @default(uuid())
  referrerId     String
  referredUserId String   @unique
  commission     Float    @default(0)
  lifetimeEarnings Float  @default(0)
  bonusPaid      Boolean  @default(false)
  createdAt      DateTime @default(now())

  referrer     User          @relation("Referrer", fields: [referrerId], references: [id])
  referredUser User          @relation("ReferredUser", fields: [referredUserId], references: [id])
  affiliateCode AffiliateCode? @relation(fields: [affiliateCodeId], references: [id])
  affiliateCodeId String?
}

// ─── Broker Directory ────────────────────────────────────────
model Broker {
  id          String @id @default(uuid())
  name        String
  logo        String?
  website     String
  apiSupport  Boolean @default(false)
  assetTypes  String[] // ["forex", "crypto", "stocks"]
  description String?
  rating      Float?   @default(0)
  createdAt   DateTime @default(now())

  connections BrokerConnection[]
}

model BrokerConnection {
  id        String   @id @default(uuid())
  userId    String
  brokerId  String
  apiKey    String   // encrypted
  apiSecret String   // encrypted
  status    String   @default("PENDING") // PENDING, CONNECTED, FAILED
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  broker Broker @relation(fields: [brokerId], references: [id])
}

// ─── Community Pulse ─────────────────────────────────────────
model CommunityEvent {
  id        String   @id @default(uuid())
  type      String   // "JOIN", "TRADE", "SIGNAL", "MILESTONE"
  message   String
  location  String?  // lat,lng for globe
  isGhost   Boolean  @default(false) // admin-seeded
  createdAt DateTime @default(now())
}

// ─── Payments ────────────────────────────────────────────────
model Payment {
  id          String   @id @default(uuid())
  userId      String
  amount      Float
  currency    String
  provider    String   // "coinbase" | "flutterwave"
  externalId  String?
  status      String   @default("PENDING") // PENDING, COMPLETED, FAILED
  metadata    Json?
  createdAt   DateTime @default(now())
}

// ─── Global Instruments Subscription (FCS API) ───────────────
enum InstrumentsTierName {
  INSTRUMENTS_FREE
  INSTRUMENTS_STARTER
  INSTRUMENTS_STANDARD
  INSTRUMENTS_PRO
  INSTRUMENTS_ULTRA
}

model InstrumentsTier {
  id            String              @id @default(uuid())
  name          InstrumentsTierName @unique
  displayName   String
  price         Float
  symbolLimit   Int
  realTime      Boolean             @default(false)
  level2Data    Boolean             @default(false)
  description   String?
  features      String[]
  createdAt     DateTime            @default(now())

  userInstrumentsSubs UserInstrumentsSub[]
}

model UserInstrumentsSub {
  id        String   @id @default(uuid())
  userId    String
  tierId    String
  active    Boolean  @default(true)
  startDate DateTime @default(now())
  endDate   DateTime?
  paymentId String?
  createdAt DateTime @default(now())

  user User             @relation(fields: [userId], references: [id])
  tier InstrumentsTier  @relation(fields: [tierId], references: [id])
}

// ─── Competition Arena ───────────────────────────────────────
enum CompetitionFrequency {
  COMP_HOURLY
  COMP_DAILY
  COMP_WEEKLY
  COMP_MONTHLY
}

enum CompetitionMode {
  BROKER
  ARENA
}

model Competition {
  id          String               @id @default(uuid())
  name        String
  frequency   CompetitionFrequency
  mode        CompetitionMode      @default(ARENA)
  entryFee    Float                @default(0)
  prizePool   Float                @default(0)
  prizeSplit  Float                @default(70)
  manualOnly  Boolean              @default(false)
  status      String               @default("OPEN")
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime             @default(now())

  entries     CompetitionEntry[]
}

model CompetitionEntry {
  id              String   @id @default(uuid())
  competitionId   String
  userId          String
  startingBalance Float    @default(10000)
  currentBalance  Float    @default(10000)
  pnl             Float    @default(0)
  rank            Int?
  settled         Boolean  @default(false)
  prizeAmount     Float    @default(0)
  joinedAt        DateTime @default(now())

  competition Competition @relation(fields: [competitionId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([competitionId, userId])
}

// ─── Partnership Form ────────────────────────────────────────
enum PartnershipStatus {
  PARTNERSHIP_PENDING
  PARTNERSHIP_ACTIVE
  PARTNERSHIP_SUSPENDED
  PARTNERSHIP_TERMINATED
}

model Partnership {
  id                  String            @id @default(uuid())
  userId              String
  entryFee            Float             @default(1)
  capitalDeposit      Float             @default(10)
  profitSplitUser     Float             @default(50)
  profitSplitPlatform Float             @default(50)
  currentTier         String            @default("BRONZE")
  totalProfit         Float             @default(0)
  totalPayout         Float             @default(0)
  status              PartnershipStatus @default(PARTNERSHIP_PENDING)
  appliedAt           DateTime          @default(now())
  activatedAt         DateTime?
  updatedAt           DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ─── Director's Salary System ────────────────────────────────
model DirectorSalary {
  id              String   @id @default(uuid())
  month           String   @unique
  grossSalary     Float    @default(10000)
  personalDraw    Float    @default(2500)
  reinvested      Float    @default(7500)
  platformRevenue Float    @default(0)
  status          String   @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime @default(now())
}

// ─── Affiliate Settlement (LX Token) ─────────────────────────
model AffiliateSettlement {
  id              String   @id @default(uuid())
  userId          String
  affiliateCodeId String
  amount          Float
  lxTokenAmount   Float
  txSignature     String?
  status          String   @default("PENDING")
  settledAt       DateTime?
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id])
  affiliateCode AffiliateCode @relation(fields: [affiliateCodeId], references: [id])
}
